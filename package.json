{
  "name": "devin_tips",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^8.57.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "deploy": "tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "lint": "eslint \"tgcloud/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" --max-warnings 0",
    "lint:fix": "eslint \"tgcloud/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" --fix --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "baseline": "node test/check-baseline.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run baseline",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check --silent"
  }
}
