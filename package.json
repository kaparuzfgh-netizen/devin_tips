{
  "name": "devin_tips",
  "private": true,
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^24.19.2",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "deploy": "tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "lint": "eslint tgcloud/**/*.js scripts/**/*.js test/**/*.js",
    "lint:fix": "eslint tgcloud/**/*.js scripts/**/*.js test/**/*.js --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  }
}
